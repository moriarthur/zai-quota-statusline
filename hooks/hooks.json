{
  "description": "Event-driven Z.AI quota refresh: sync scripts to a stable path on session start, then refresh the quota cache on prompt submit and turn end.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/sync.sh\" && \"$HOME/.claude/zaiquota/quota-hook.sh\" session",
            "timeout": 20,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/zaiquota/quota-hook.sh pre",
            "timeout": 20,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/zaiquota/quota-hook.sh post",
            "timeout": 20,
            "async": true
          }
        ]
      }
    ]
  }
}
