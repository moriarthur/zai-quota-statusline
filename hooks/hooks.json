{
  "description": "Event-driven Z.AI quota refresh: a fast blocking one-liner syncs the scripts to a stable path on session start, prompt submit / turn end re-sync that path when a plugin update landed mid-session and refresh the cache event-driven, and the first quota fetch fires in the background so startup never waits on the network.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/sync.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/sync.sh\" && \"${ZAI_QUOTA_DIR:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}/zaiquota}/quota-hook.sh\" session",
            "timeout": 20,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/ensure-current.sh\" ; \"${ZAI_QUOTA_DIR:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}/zaiquota}/quota-hook.sh\" pre",
            "timeout": 20,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/ensure-current.sh\" ; \"${ZAI_QUOTA_DIR:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}/zaiquota}/quota-hook.sh\" post",
            "timeout": 20,
            "async": true
          }
        ]
      }
    ]
  }
}
